[importlinter]
root_package = kagweb

[importlinter:contract:core-purity]
name = Core contains values and protocols only
type = forbidden
source_modules =
    kagweb.core
forbidden_modules =
    kagweb.app
    kagweb.api
    kagweb.runtime
    kagweb.services

[importlinter:contract:no-api-backimports]
name = Runtime and service layers do not import API adapters
type = forbidden
source_modules =
    kagweb.runtime
    kagweb.services
    kagweb.multi_user
    kagweb.capabilities
forbidden_modules =
    kagweb.api

[importlinter:contract:app-adapter-direction]
name = Application does not import API adapters
type = forbidden
source_modules =
    kagweb.app
forbidden_modules =
    kagweb.api
