# ============================================
# KAGWeb Docker Ignore File
# ============================================
# Excludes files and directories from the Docker build context
# to improve build speed and reduce image size
# ============================================

# ============================================
# Git
# ============================================
.git
.gitignore
.gitattributes

# ============================================
# Documentation
# Keep LICENSE and THIRD_PARTY_NOTICES.md out of the exclusions: the image
# ships them so distributed images carry the Apache-2.0 license text and
# the adapted/vendored third-party notices.
# ============================================
*.md
!README.md
!THIRD_PARTY_NOTICES.md
docs/
assets/gifs/
assets/figs/
assets/README/

# ============================================
# Python
# ============================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
MANIFEST

# Virtual environments
.env
*.env
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
KAGWeb.env

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.dmypy.json
dmypy.json

# ============================================
# Node.js
# ============================================
node_modules/
**/node_modules/
web/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
web/.next/
web/.next-*/
out/
web/out/
*.tsbuildinfo

# ============================================
# IDE and Editor
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ============================================
# Docker
# ============================================
Dockerfile*
docker-compose*.yml
.docker/
.dockerignore

# ============================================
# User Data (mounted as volumes, never baked into the image)
# ============================================
# The entire data/ tree stays out of the build context: besides workspace
# content it holds data/system (auth state, provider API keys, per-owner
# secrets), data/pocketbase (auth DB) and data/redis. No Dockerfile COPYs
# from it — the runtime directories are created by the entrypoint on the
# mounted volume instead.
data/
run_code_workspace/

# ============================================
# Development and Testing
# ============================================
develop/
.claude/
.agents/
.playwright-cli/
deploy/
site/
scripts/extract_numbered_items.sh
output/
outputs/
web/tmp/
web/test-results/
web/playwright-report/
*.log
logs/
*.bak
*.tmp

# ============================================
# Temporary and Cache Files
# ============================================
.cache/
cache/
**/cache/
tmp/
temp/
*.tmp
*.temp

# ============================================
# Communication
# (LICENSE is intentionally NOT excluded — see the Documentation section)
# ============================================
Communication.md
